{
  "name": "@theholocron/node-template",
  "version": "1.2.1",
  "description": "<description>",
  "homepage": "<homepage>",
  "bugs": "https://github.com/theholocron/node-template/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/theholocron/node-template.git"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@theholocron/semantic-release-config": "catalog:configs",
    "@theholocron/cli": "catalog:holocron",
    "@theholocron/commitlint-config": "catalog:configs",
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/holocron-config": "catalog:configs",
    "@theholocron/prettier-config": "catalog:configs",
    "@theholocron/tsconfig": "catalog:configs",
    "@theholocron/tsdown-config": "catalog:configs",
    "@theholocron/vitest-config": "catalog:configs",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "releases": "https://github.com/theholocron/node-template/releases",
  "wiki": "https://github.com/theholocron/node-template/wiki"
}
